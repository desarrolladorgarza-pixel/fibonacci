# Programador de Fibonacci.
#   sudo cp deploy/fibonacci-*.service /etc/systemd/system/
#   sudo systemctl enable --now fibonacci-schedule@$USER
[Unit]
Description=Fibonacci — programador de tareas
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=%i
WorkingDirectory=%h
ExecStart=%h/.local/bin/fib schedule serve
Restart=on-failure
RestartSec=30
# El agente escribe en su workspace y su data dir; nada más.
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.local/share/fibonacci %h/.config/fibonacci %h/fibonacci
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
